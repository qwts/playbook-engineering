#!/bin/sh
# Wrapper for the Claude Code WorktreeCreate hook (ENG-0016, ENG-0045).
#
# The hook is spawned by the Claude Code desktop app, not by a login shell, so
# a node installed through nvm may be absent from its PATH. This loads nvm only
# when node is missing, keeps every byte of nvm's own output off stdout (the
# hook's stdout IS the worktree path Claude Code consumes), and execs the real
# implementation next to it.
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v node >/dev/null 2>&1; then
  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  echo "claude-worktree-create: node not found on PATH (and no nvm at ${NVM_DIR:-$HOME/.nvm})" >&2
  exit 127
fi

exec node "$DIR/claude-worktree-create.mjs" "$@"
